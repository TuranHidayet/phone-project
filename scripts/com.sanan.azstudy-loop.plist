<?xml version="1.0" encoding="UTF-8"?>
<!--
  AzStudy botunu davamli isledir (her 4 deqiqede bir dovr).

  launchd loop skriptini bir defe baslatir; dovrleri skriptin ozu sayir
  (CYCLE saniye). KeepAlive: skript hansisa sebebden dayanarsa (ve ya
  komputer yeniden acilarsa) launchd onu yeniden baslatir.

  caffeinate -i: komputer bosdayken yatmasin, yoxsa dovrler dayanir.

  Yuklemek:   launchctl load -w ~/Library/LaunchAgents/com.sanan.azstudy-loop.plist
  Dayandirmaq: launchctl unload -w ~/Library/LaunchAgents/com.sanan.azstudy-loop.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sanan.azstudy-loop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/a1234/phone-project/scripts/azstudy_loop.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/a1234/phone-project</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- MOBIL DATA REJIMI (2026-09-07): Redmi Note 9 Nar SIM-i ile, Wi-Fi
             sonulu, kabel uzerinden isleyir. Public IP artiq operatorundur,
             ona gore botun sonundaki ucus rejimi her isde IP-ni firladir.
             CYCLE 240: bir is ~220 san cekir, yeni dovre kicik buferle sigir.
             Data serfi olculur, paket ona gore artirilacaq.
             Tesviri hesab: ~360 is/gun x ~7 MB = ~2.5 GB/gun = ~74 GB/ay. -->
        <key>CYCLE</key>
        <string>240</string>
        <!-- PHONES 4 -> 1: hazirda yalniz bir telefon qosuludur ve o, USB-dedir.
             4 qalsaydi find_phone.sh her dovrde alt sebekeni bosuna tarardi
             (~20 san). Wi-Fi-li telefon elave olunanda bu deyeri artirmaq lazimdir. -->
        <key>PHONES</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/a1234/phone-project/logs/azstudy_loop.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/a1234/phone-project/logs/azstudy_loop.log</string>
</dict>
</plist>
